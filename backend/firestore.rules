rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Salas — somente participantes podem ler/escrever.
    // Validação de integridade no servidor (nunca confie no cliente).
    // ============================================================
    match /rooms/{code} {
      allow read: if isParticipant(code);
      allow create: if isParticipant(code)
        && request.resource.data.code == code
        && request.resource.data.status == 'open';
      allow update: if isParticipant(code)
        && request.resource.data.code == code
        && validRoomUpdate(request.resource.data);

      // Somente o criador fecha a sala? Não — qualquer participante,
      // como no app. Mas valida status válido.
    }

    // ============================================================
    // Histórico — somente participantes da sala leem.
    // ============================================================
    match /history/{code} {
      allow read: if isParticipant(code);
      allow create: if isParticipant(code);
    }

    // ============================================================
    // Feedback — autenticado anonimamente pode enviar.
    // ============================================================
    match /feedback/{id} {
      allow create: if request.auth != null;
      allow read: if false; // apenas via painel admin
    }

    function isParticipant(code) {
      return request.auth != null
        && get(/databases/$(database)/documents/rooms/$(code)).data.participants
          .any(p => p.id == request.auth.uid);
    }

    function validRoomUpdate(room) {
      return room.keys().hasAll(['code', 'tableName', 'participants', 'items', 'status', 'currency'])
        && room.tableName is string
        && room.participants is list
        && room.items is list
        && room.status in ['open', 'closed']
        && room.currency is string;
    }
  }
}
